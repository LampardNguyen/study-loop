<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 的 SplashScreen 会把图标放入约 288dp 的系统槽位。
    用 layer-list 固定 288dp 画布（不受位图 intrinsic size 影响），
    位图本身即 288dp 画布、品牌图案居中占 96dp（只放 xxxhdpi 一份，系统按密度缩放）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/startup_splash_logo" />
</layer-list>
